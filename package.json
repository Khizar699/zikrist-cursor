{
  "name": "zikrist",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "node scripts/run-native.mjs ios",
    "android": "node scripts/run-native.mjs android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "setup": "node scripts/setup.mjs",
    "assets:download": "node scripts/download-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "liturgy:verify": "node scripts/verify-salah-liturgy.mjs",
    "export": "expo export --platform ios --platform android",
    "postinstall": "patch-package",
    "test:replay": "tsx scripts/replay.ts",
    "test:replay:core": "tsx scripts/replay.ts core",
    "test:replay:all": "tsx scripts/replay.ts all",
    "test:replay:real-imam": "tsx scripts/replay.ts real-imam",
    "test:replay:liturgy": "tsx scripts/replay.ts liturgy",
    "liturgy:tts": "tsx scripts/gen-liturgy-tts.ts",
    "fixtures:recitation": "tsx scripts/download-recitation-fixtures.ts",
    "fixtures:imam": "tsx scripts/download-imam-fixtures.ts",
    "test:coverage": "tsx scripts/coverage-sample.ts",
    "findings:report": "tsx scripts/findings-report.ts",
    "benchmark": "tsx scripts/replay.ts"
  },
  "dependencies": {
    "@tilawa/core": "0.1.0",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-keep-awake": "~57.0.2",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "fastest-levenshtein": "1.0.16",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "0.13.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "^57.0.2",
    "onnxruntime-node": "^1.24.3",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "onnxruntime-node": {
      "adm-zip": "0.6.1"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "allowScripts": {
    "onnxruntime-node@1.24.3": true
  }
}
