{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zikrist.local/findings.schema.json",
  "title": "ZikristRecognitionFinding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "status",
    "class",
    "owner",
    "want",
    "got",
    "source",
    "created_at"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$",
      "description": "Stable id for a recorded recognition miss."
    },
    "status": { "type": "string", "enum": ["open", "closed", "deferred"] },
    "class": {
      "type": "string",
      "enum": [
        "cold_miss",
        "false_lock",
        "stall",
        "wrong_handoff",
        "soft_after_expect",
        "missing_fixture",
        "missing_onnx"
      ]
    },
    "owner": {
      "type": "string",
      "enum": ["locate", "follow", "gate", "fixture", "infra"]
    },
    "want": {
      "description": "Expected verse refs, or empty when a negative suite must not lock.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surah", "ayah"],
        "properties": {
          "surah": { "type": "integer", "minimum": 1, "maximum": 114 },
          "ayah": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "got": {
      "description": "Observed locks; empty array means none.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surah", "ayah"],
        "properties": {
          "surah": { "type": "integer", "minimum": 1, "maximum": 114 },
          "ayah": { "type": "integer", "minimum": 1 },
          "at_seconds": { "type": ["number", "null"] }
        }
      }
    },
    "source": {
      "type": "string",
      "enum": ["floor", "coverage_tier_a", "coverage_tier_b", "product_bar", "manual"]
    },
    "suite_or_clip": { "type": "string" },
    "clip_class": {
      "type": ["string", "null"],
      "enum": [
        "famous-short",
        "mid-surah",
        "fatiha-to-body",
        "non-famous-cold",
        "long-imam",
        "synthetic",
        null
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" },
    "closed_by": { "type": ["string", "null"] },
    "environment": { "type": ["string", "null"] }
  }
}
